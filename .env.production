# 운영(S3+CloudFront) 배포용 설정. 시크릿이 아니라(NEXT_PUBLIC_ 값은 전부 브라우저 번들에
# 그대로 노출됨) 커밋해서 CI(GitHub Actions)가 별도 설정 없이 바로 빌드하게 한다.

# TODO: 백엔드에 HTTPS(Nginx+Let's Encrypt)를 붙이기 전까지는 http이고, CloudFront가
# 프론트를 https로 서빙하는 순간 브라우저의 mixed content 차단으로 API 호출이 전부 막힌다.
# 백엔드 HTTPS 적용 후 이 값을 https://ec2-43-200-18-153.ap-northeast-2.compute.amazonaws.com/api/v1
# 로 바꿔야 실제로 동작한다.
NEXT_PUBLIC_API_BASE_URL=http://ec2-43-200-18-153.ap-northeast-2.compute.amazonaws.com:8080/api/v1

# 카카오 로그인 REST API 키 — 카카오 개발자 콘솔에 공개돼도 되는 값(클라이언트 시크릿과 다름).
NEXT_PUBLIC_KAKAO_CLIENT_ID=d29f17103e39bc5bae8d459fce2a6bb9

# 카카오 개발자 콘솔의 "Redirect URI" 목록에 이 값도 등록되어 있어야 한다.
NEXT_PUBLIC_KAKAO_REDIRECT_URI=https://daykk50lolyq6.cloudfront.net/login/kakao/callback
