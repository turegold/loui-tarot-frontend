# 운영(S3+CloudFront) 배포용 설정. 시크릿이 아니라(NEXT_PUBLIC_ 값은 전부 브라우저 번들에
# 그대로 노출됨) 커밋해서 CI(GitHub Actions)가 별도 설정 없이 바로 빌드하게 한다.

# 백엔드는 Nginx + Let's Encrypt로 api.watchy.site에 HTTPS가 적용되어 있다.
NEXT_PUBLIC_API_BASE_URL=https://api.watchy.site/api/v1

# 카카오 로그인 REST API 키 — 카카오 개발자 콘솔에 공개돼도 되는 값(클라이언트 시크릿과 다름).
NEXT_PUBLIC_KAKAO_CLIENT_ID=d29f17103e39bc5bae8d459fce2a6bb9

# www를 canonical 도메인으로 쓴다 — 에펙스(watchy.site)는 가비아 포워딩으로 www로 리다이렉트되므로,
# 카카오 로그인 흐름이 시작되는 시점엔 항상 www에 있어 redirect_uri가 흔들리지 않는다.
# 카카오 개발자 콘솔의 "Redirect URI" 목록에 이 값도 등록되어 있어야 한다.
NEXT_PUBLIC_KAKAO_REDIRECT_URI=https://www.watchy.site/login/kakao/callback
