# 로컬 백엔드(Spring Boot, localhost:8080) 연동 설정. 시크릿이 아니라(NEXT_PUBLIC_ 값은 전부
# 브라우저 번들에 그대로 노출됨) 커밋해서 누구나 npm run dev만으로 바로 연동되게 한다.

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# 카카오 로그인 REST API 키 — 카카오 개발자 콘솔에 공개돼도 되는 값(클라이언트 시크릿과 다름).
NEXT_PUBLIC_KAKAO_CLIENT_ID=d29f17103e39bc5bae8d459fce2a6bb9

# 백엔드(application-local.yml)의 kakao.redirect-uri와 정확히 같아야 한다 — 카카오가
# 인가코드 발급 시점과 토큰 교환 시점의 redirect_uri가 일치하는지 검증하기 때문.
NEXT_PUBLIC_KAKAO_REDIRECT_URI=http://localhost:3001/login/kakao/callback
