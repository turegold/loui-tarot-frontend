# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.development는 시크릿이 아니라 로컬 백엔드 연동 기본값(NEXT_PUBLIC_ 뿐)이라 커밋해서 공유한다
!.env.development

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local AI coding tool config — not meant to be public
AGENTS.md
CLAUDE.md
