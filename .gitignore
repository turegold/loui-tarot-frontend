# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.development/.env.production은 시크릿이 아니라 NEXT_PUBLIC_ 값뿐이라 커밋해서 공유한다
!.env.development
!.env.production

# vercel
.vercel

# 카드 이미지 원본(고해상도) 작업 폴더 — public/cards에 리사이즈된 결과물만 커밋한다
/imgs

# typescript
*.tsbuildinfo
next-env.d.ts

# local AI coding tool config — not meant to be public
AGENTS.md
CLAUDE.md
